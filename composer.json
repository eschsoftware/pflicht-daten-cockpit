        "description": {
            "de-DE": "Prüft GPSR-Herstellerangaben und sperrt den Checkout, solange Name, Adresse oder Kontakt fehlen.",
            "en-GB": "Checks GPSR manufacturer details and blocks checkout while the name, address or contact is missing."
        },
        "manufacturerLink": {
            "de-DE": "https://eschsoftware.de",
            "en-GB": "https://eschsoftware.de"
        },
        "supportLink": {
            "de-DE": "https://eschsoftware.de/de/contact/",
            "en-GB": "https://eschsoftware.de/de/contact/"
        }
    },
    "autoload": {
        "psr-4": {
            "EschSoftware\\PflichtDatenCockpit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EschSoftware\\PflichtDatenCockpit\\Test\\": "tests/"
        }
    }
