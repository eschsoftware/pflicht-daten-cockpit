{
    "name": "eschsoftware/pflicht-daten-cockpit",
    "description": "Prüft GPSR-Herstellerangaben in der Administration. Fehlende Angaben stehen in der Übersicht, beim Speichern erscheint eine Warnung. Der Endkunde sieht nichts.",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "version": "1.1.0",
    "homepage": "https://eschsoftware.de/de/pflicht-daten-cockpit/",
    "support": {
        "issues": "https://eschsoftware.de/de/contact/",
        "source": "https://github.com/eschsoftware/pflicht-daten-cockpit"
    },
    "authors": [
        {
            "name": "EschSoftware"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": ">=6.7.16.1 <6.8.0"
    },
    "extra": {
        "shopware-plugin-class": "EschSoftware\\PflichtDatenCockpit\\EschSoftwarePflichtDatenCockpit",
        "plugin-icon": "src/Resources/config/plugin.png",
        "copyright": "(c) EschSoftware",
        "label": {
            "de-DE": "Pflicht-Daten-Cockpit",
            "en-GB": "Mandatory Data Cockpit"
        },
        "description": {
            "de-DE": "Prüft GPSR-Herstellerangaben in der Administration. Fehlende Angaben stehen in der Übersicht, beim Speichern erscheint eine Warnung. Der Endkunde sieht nichts.",
            "en-GB": "Checks GPSR manufacturer details in the Administration. Missing details show in the overview and saving shows a warning. The customer sees nothing."
        },
        "manufacturerLink": {
            "de-DE": "https://eschsoftware.de",
            "en-GB": "https://eschsoftware.de"
        },
        "supportLink": {
            "de-DE": "https://eschsoftware.de/de/contact/",
            "en-GB": "https://eschsoftware.de/de/contact/"
        }
    },
    "autoload": {
        "psr-4": {
            "EschSoftware\\PflichtDatenCockpit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EschSoftware\\PflichtDatenCockpit\\Test\\": "tests/"
        }
    }
}
