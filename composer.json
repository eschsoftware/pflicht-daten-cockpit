            "email": "mail@eschsoftware.de",
            "homepage": "https://eschsoftware.de",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "mail@eschsoftware.de",
        "issues": "https://github.com/eschsoftware/pflicht-daten-cockpit/issues",
        "source": "https://github.com/eschsoftware/pflicht-daten-cockpit",
        "docs": "https://eschsoftware.de/de/pflicht-daten-cockpit/"
    },
    "require": {
        "php": ">=8.2",
        "shopware/core": ">=6.7.16.1 <6.8.0"
    },
    "extra": {
        "shopware-plugin-class": "EschSoftware\\PflichtDatenCockpit\\EschSoftwarePflichtDatenCockpit",
        "plugin-icon": "src/Resources/config/plugin.png",
        "copyright": "(c) EschSoftware",
        "label": {
            "de-DE": "Pflicht-Daten-Cockpit",
            "en-GB": "Mandatory Data Cockpit"
