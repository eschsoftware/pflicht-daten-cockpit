<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="EschSoftware\PflichtDatenCockpit\Core\Rule\GpsrManufacturerRule"/>

        <service id="EschSoftware\PflichtDatenCockpit\Core\GpsrManufacturerFieldInstaller" public="true">
            <argument type="service" id="custom_field_set.repository"/>
        </service>

        <service id="EschSoftware\PflichtDatenCockpit\Core\GpsrManufacturerScanner">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="product_manufacturer.repository"/>
            <argument type="service" id="EschSoftware\PflichtDatenCockpit\Core\Rule\GpsrManufacturerRule"/>
        </service>

        <service id="EschSoftware\PflichtDatenCockpit\Core\GpsrManufacturerDataCleaner" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="EschSoftware\PflichtDatenCockpit\Administration\GpsrManufacturerController" public="true">
            <argument type="service" id="EschSoftware\PflichtDatenCockpit\Core\GpsrManufacturerScanner"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

    </services>
</container>
